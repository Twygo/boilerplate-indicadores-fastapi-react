DATABASE_URL=postgresql://indicadores:indicadores@db:5432/indicadores
CORS_ORIGINS=["http://localhost:5173"]

# Login pelo Twygo Hub. "none" = sem login (padrão). "hub" = exige o X-Hub-Token.
AUTH_MODE=none
HUB_JWKS_URL=https://hub.apps.twygo.com/.well-known/jwks.json
HUB_ISSUER=https://hub.apps.twygo.com
HUB_AUDIENCE=indicadores
